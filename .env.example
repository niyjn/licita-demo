DATABASE_URL=postgresql://licita:licita@localhost:5432/licita
DB_POOL_MIN=1
DB_POOL_MAX=5
APP_VERSION=dev
ANON_COOKIE_DAYS=180
# Use false only in local HTTP development/tests. Keep true in production.
ANON_COOKIE_SECURE=true
# Required in production and shared by every web ECS task.
CSRF_SECRET=replace-with-a-long-random-secret
PDF_DIR=output/pdfs
S3_BUCKET_NAME=
AWS_REGION=us-east-1

HTTP_MAX_RETRIES=5
HTTP_BACKOFF_BASE_SECONDS=2
HTTP_BACKOFF_MAX_SECONDS=120
HTTP_JITTER_SECONDS=1

OCR_DPI=180
OCR_MAX_PAGES=20
PDF_TEXT_MAX_PAGES=0
PDF_TEXT_TIMEOUT_SECONDS=180
