POSTGRES_DB=licitacoes
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo
POSTGRES_PORT=5432
DATABASE_URL=postgresql://demo:demo@localhost:5432/licitacoes

FAILURE_WEBHOOK_URL=
FAILURE_WEBHOOK_TIMEOUT_SECONDS=10

PDF_RETENTION_DAYS=30
RUN_LIMIT_MIN=30
RUN_LIMIT_DEFAULT=50
RUN_LIMIT_MAX=200
ENABLE_DB_CHECKPOINT=true

HTTP_MAX_RETRIES=5
HTTP_BACKOFF_BASE_SECONDS=2
HTTP_BACKOFF_MAX_SECONDS=120
HTTP_JITTER_SECONDS=1

OCR_DPI=180
OCR_MAX_PAGES=20
PDF_TEXT_MAX_PAGES=0
PDF_TEXT_TIMEOUT_SECONDS=180
